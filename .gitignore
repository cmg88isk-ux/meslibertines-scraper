# ─────────────────────────────────────────────────────────────────────────────
# Secrets. Nothing in this section may ever reach the remote.
# ─────────────────────────────────────────────────────────────────────────────
# Covers .env, .env.bak, .env.local, .env.production, .env.staging...
# The negation is what keeps the documented template trackable.
.env
.env.*
!.env.example
.envrc
*.env
*.bak

# Credentials and account lists, in whatever format they show up.
credentials.txt
credentials.csv
accounts.json
secrets.json
*.pem
*.key

# ─────────────────────────────────────────────────────────────────────────────
# Real scraped data: passwords, postal addresses, contract numbers.
# ─────────────────────────────────────────────────────────────────────────────
result/
*_dump.json
*_dump.txt
meslibertines-profile/
meslibertines-state.json
# Comptes en entree et verdicts en sortie: jamais committes.
targets/*
!targets/.gitkeep
!targets/accounts.txt.example
output/*
!output/.gitkeep
# Memes fichiers, variantes de travail ciblees (VIP) et sorties paralleles.
targets_vip/
output_vip/
output_vip2/
yomoni_results.txt
verify-*.jsonl
verify-*.txt
accounts-*.txt
*.log

# ─────────────────────────────────────────────────────────────────────────────
# Superseded scaffolding from the exploration phase. Kept out of the history:
# they hardcode one provider and duplicate logic that now lives in transports.py.
# Delete them once you are sure you do not need them again.
# ─────────────────────────────────────────────────────────────────────────────
diag_auth.py
diag_yomoni.py
explore_yomoni.py
login_yomoni.py
scrape_yomoni_account.py
KernelBrowser.py
scrape_afer.py
diag_*.json
diagnostic_*.json

# ─────────────────────────────────────────────────────────────────────────────
# Python and tooling
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tmp

