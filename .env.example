# Provider keys. Copy to .env and fill in.
# NEVER commit the real .env: it holds live API keys and account passwords.

# --- Browserbase -----------------------------------------------------------
# https://browserbase.com - cloud Chrome. One key per account, or several keys
# comma-separated in the same variable. The pool rotates across all of them.
BROWSERBASE_API_KEY=
BROWSERBASE_API_KEY_2=

# --- Kernel ----------------------------------------------------------------
# https://onkernel.com - stealth Chrome. Same numbering scheme.
KERNEL_API_KEY=
KERNEL_API_KEY_2=

# --- Webshare (optional) ---------------------------------------------------
# Residential proxy pool. Not needed for the Browserbase/Kernel pipeline, which
# already rotates exit IPs; only useful if you run a local browser through it.
WEBSHARE_API_TOKEN=
