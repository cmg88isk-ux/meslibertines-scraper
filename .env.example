# Provider keys. Copy to .env and fill in.
# NEVER commit the real .env: it holds live API keys and account passwords.

# --- Browserbase -----------------------------------------------------------
# https://browserbase.com - cloud Chrome. One key per line, numbered; the pool
# rotates and falls back across all of them. Add BROWSERBASE_API_KEY_3, _4...
BROWSERBASE_API_KEY=
BROWSERBASE_API_KEY_2=

# --- Kernel ----------------------------------------------------------------
# https://onkernel.com - stealth Chrome. Same numbering scheme. Keep every key
# in the pool: they are all used in rotation and as fallback.
KERNEL_API_KEY=
KERNEL_API_KEY_2=

# --- Webshare (optional) ---------------------------------------------------
# Residential proxy pool. Not needed for the Browserbase/Kernel pipeline, which
# already rotates exit IPs; only useful if you run a local browser through it.
WEBSHARE_API_TOKEN=

# --- meslibertines.com (login_meslibertines.py) ----------------------------
# The single personal account. --via picks the browser backend: local uses a
# persistent Chromium (ML_PROXY or the Webshare vars below for the exit IP),
# browserbase / kernel use the cloud transports with their CAPTCHA solvers.
# On a datacenter host, prefer: --via kernel --tries 3 (Browserbase is flaky).
ML_USERNAME=
ML_PASSWORD=
# ML_VIA=local
# ML_PROXY=http://user:pass@host:port

# --- Webshare residential proxy (optional) ---------------------------------
# Read by login_meslibertines.py when ML_PROXY is unset: the proxy URL is built
# from these, so a stuck Cloudflare challenge gets a fresh residential IP.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# WEBSHARE_PROXY_ENDPOINT=p.webshare.io:80
